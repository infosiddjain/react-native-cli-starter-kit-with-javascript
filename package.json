{
  "name": "react-native-starter-kit-js",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "android": "react-native run-android",
    "android:release": "APP_ENV=production react-native run-android --mode release",
    "ios": "react-native run-ios",
    "ios:release": "APP_ENV=production react-native run-ios --mode Release",
    "setup:env": "node scripts/setup-env.js",
    "postinstall": "npm run setup:env --silent",
    "lint": "eslint .",
    "test": "jest",
    "icons:ios": "rnvi-update-plist package.json ios/StarterKit/Info.plist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "^3.5.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.1",
    "react-native-worklets": "^0.13.1",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^5.0.0",
    "react-test-renderer": "19.3.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
