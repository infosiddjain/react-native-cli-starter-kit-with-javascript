# Copy this file to set up your environment:
#   cp .env.example .env.development   (used by debug builds / npm start)
#   cp .env.example .env.production    (used by release builds)
# .env is the shared fallback; .env.<APP_ENV> values override it.
#
# These values end up inside the app bundle, so anyone can read them.
# Never put real secrets (private API keys, passwords) here.
# After changing a value, restart Metro with: npm run start:reset

APP_ENV=development
API_BASE_URL=https://dummyjson.com
API_TIMEOUT=15000
ENABLE_API_LOGS=true
